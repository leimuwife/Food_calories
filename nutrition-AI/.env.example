# ==================== 服务配置 ====================
# 服务端口（如被占用可更换为8001/8088等）
SERVER_PORT=8004
# 服务主机（Windows本地调试建议用127.0.0.1，部署时用0.0.0.0）
SERVER_HOST=127.0.0.1

# ==================== API鉴权配置 ====================
# API密钥（Java后端调用Python时携带，Java端 application.yml 的 fastapi.api-secret-key 必须与此一致）
API_SECRET_KEY=your-api-secret-key

# ==================== Redis 缓存配置（食材基础热量缓存） ====================
# Redis连接信息（与Java后端共用同一个Redis，Java侧缓存key为 food:nutrition）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== 大模型LLM请求超时（秒） ====================
# LLM模型配置（apiKey/baseUrl/model/temperature）由Java端写入Redis，Python从Redis读取
# 此处仅保留Python侧请求超时控制
LLM_TIMEOUT=60

# ==================== 阿里云 DashVector 向量数据库配置 ====================
# 向量库访问地址（Cluster Endpoint，在DashVector控制台获取）
VECTOR_ENDPOINT=your-cluster-endpoint.dashvector.cn-beijing.aliyuncs.com
# 向量库API密钥（在阿里云DashVector控制台获取）
VECTOR_API_KEY=your-dashvector-api-key
# 向量库集合名称
VECTOR_COLLECTION_NAME=food_nutrition_knowledge

# ==================== 阿里云 DashScope Embedding 配置 ====================
# DashScope API密钥（在阿里云百炼控制台获取，用于 text-embedding-v4）
DASHSCOPE_API_KEY=your-dashscope-api-key
# Embedding模型名称
EMBEDDING_MODEL=text-embedding-v4

# ==================== 文本分割配置 ====================
# 单片段长度（字符数）
CHUNK_SIZE=500
# 片段重叠长度（字符数）
CHUNK_OVERLAP=50
# 分割符列表（按优先级排序）
SEPARATORS=["\n\n", "\n", "。", "！", "？", ".", "!", "?", "；", ";", "，", ",", " ", ""]

# ==================== Java回调配置 ====================
# Java后端回调接口地址（对应RagKnowledgeController.callback）
# Controller: @RequestMapping("/rag/knowledge") + @PostMapping("/callback")
# 全局前缀 + 路径 = /api/rag/knowledge/callback
JAVA_CALLBACK_URL=http://localhost:8088/api/rag/knowledge/callback

# ==================== 日志配置 ====================
# 日志级别
LOG_LEVEL=INFO
