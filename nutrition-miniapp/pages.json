{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "今日饮食",
        "navigationBarBackgroundColor": "#7EC8A0",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/food-library/index",
      "style": {
        "navigationBarTitleText": "食物库",
        "navigationBarBackgroundColor": "#7EC8A0",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/statistics/index",
      "style": {
        "navigationBarTitleText": "统计分析",
        "navigationBarBackgroundColor": "#7EC8A0",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationBarTitleText": "历史记录",
        "navigationBarBackgroundColor": "#7EC8A0",
        "navigationBarTextStyle": "white"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationBarTitleText": "个人中心",
        "navigationBarBackgroundColor": "#7EC8A0",
        "navigationBarTextStyle": "white"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "营养助手",
    "navigationBarBackgroundColor": "#7EC8A0",
    "backgroundColor": "#F5F7FA"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#5BA07A",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日饮食",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/food-library/index",
        "text": "食物库",
        "iconPath": "static/tabbar/search.png",
        "selectedIconPath": "static/tabbar/search-active.png"
      },
      {
        "pagePath": "pages/statistics/index",
        "text": "统计分析",
        "iconPath": "static/tabbar/chart.png",
        "selectedIconPath": "static/tabbar/chart-active.png"
      },
      {
        "pagePath": "pages/history/index",
        "text": "历史记录",
        "iconPath": "static/tabbar/clock.png",
        "selectedIconPath": "static/tabbar/clock-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "个人中心",
        "iconPath": "static/tabbar/user.png",
        "selectedIconPath": "static/tabbar/user-active.png"
      }
    ]
  }
}
