<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nutrition.mapper.FeedCommentMapper">

    <select id="selectCommentsByFeedId" resultType="com.nutrition.entity.FeedComment">
        SELECT
            id,
            feed_id,
            user_id,
            content,
            create_time
        FROM
            feed_comment
        WHERE
            feed_id = #{feedId}
            AND delete_flag = 0
        ORDER BY
            create_time ASC
        LIMIT 3
    </select>

</mapper>