<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nutrition.mapper.FeedMapper">

    <update id="batchUpdateFeedCount">
        <if test="updateList != null and updateList.size() > 0">
            UPDATE feed
            SET
                like_count = CASE id
                <foreach collection="updateList" item="item">
                    <if test="item.likeCount != null">
                        WHEN #{item.feedId} THEN #{item.likeCount}
                    </if>
                </foreach>
                ELSE like_count END,
                comment_count = CASE id
                <foreach collection="updateList" item="item">
                    <if test="item.commentCount != null">
                        WHEN #{item.feedId} THEN #{item.commentCount}
                    </if>
                </foreach>
                ELSE comment_count END
            WHERE id IN
            <foreach collection="updateList" item="item" open="(" separator="," close=")">
                #{item.feedId}
            </foreach>
        </if>
    </update>

    <select id="selectFeedList" resultType="com.nutrition.entity.Feed">
        SELECT
            id,
            user_id,
            content,
            file_ids,
            like_count,
            comment_count,
            create_time
        FROM
            feed
        WHERE
            delete_flag = 0
        ORDER BY
            create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="selectFeedCount" resultType="java.lang.Long">
        SELECT
            COUNT(id)
        FROM
            feed
        WHERE
            delete_flag = 0
    </select>

</mapper>