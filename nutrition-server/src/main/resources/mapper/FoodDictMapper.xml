<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nutrition.mapper.FoodDictMapper">

    <resultMap id="FoodVOResultMap" type="com.nutrition.vo.FoodVO">
        <id column="id" property="id"/>
        <result column="food_name" property="foodName"/>
        <result column="category" property="category"/>
        <result column="calories_per_100g" property="caloriesPer100g"/>
        <result column="protein_per_100g" property="proteinPer100g"/>
        <result column="fat_per_100g" property="fatPer100g"/>
        <result column="carbs_per_100g" property="carbsPer100g"/>
        <result column="fiber_per_100g" property="fiberPer100g"/>
        <result column="edible_portion" property="ediblePortion"/>
        <result column="data_source" property="dataSource"/>
    </resultMap>

    <select id="search" resultMap="FoodVOResultMap">
        SELECT id, food_name, category, calories_per_100g, protein_per_100g, fat_per_100g, carbs_per_100g, fiber_per_100g, edible_portion, data_source
        FROM food_dict WHERE 1=1
        <if test="keyword != null and keyword != ''">
            AND food_name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        <if test="category != null and category != ''">
            AND category = #{category}
        </if>
        ORDER BY id LIMIT 50
    </select>

    <select id="getAllCategories" resultType="com.nutrition.vo.FoodCategoryVO">
        SELECT DISTINCT category FROM food_dict ORDER BY category
    </select>

</mapper>
